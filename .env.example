VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set true only after enabling Discord in Supabase Auth.
VITE_DISCORD_AUTH_ENABLED=false
# Public server invite only; never put a bot token or OAuth secret in VITE_*.
VITE_DISCORD_INVITE_URL=

# Edge Function CORS allowlist. Configure as Supabase secret, not as frontend env.
# Example: https://app.example.com,https://staging.example.com
FOCUSEDU_ALLOWED_ORIGINS=
# Edge Function worker secret. Store the same value in Supabase Vault as
# focusedu_discord_worker_secret for pg_cron/pg_net calls.
DISCORD_WORKER_SECRET=

# Production smoke script inputs. Use the public publishable key only.
FOCUSEDU_SMOKE_BASE_URL=
FOCUSEDU_SMOKE_SUPABASE_URL=
FOCUSEDU_SMOKE_SUPABASE_PUBLISHABLE_KEY=
